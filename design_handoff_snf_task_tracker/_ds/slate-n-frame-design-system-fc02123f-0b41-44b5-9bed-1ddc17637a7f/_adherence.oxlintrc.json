{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/slides/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Uni Neue Black|DM Sans|Archivo Black))/i]",
        "message": "Font not provided by the design system. Available: Uni Neue Black, DM Sans, Archivo Black."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|speed|reactToScroll|className|style|key|ref|className|style|children)$/]",
        "message": "<AnimatedIcon> doesn't accept that prop. Declared props: name, size, color, speed, reactToScroll, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:aperture|lens|motion|pulse|light|capture)$/]",
        "message": "<AnimatedIcon> name must be one of 'aperture' | 'lens' | 'motion' | 'pulse' | 'light' | 'capture'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedIcon'] > JSXAttribute[name.name='speed'] > Literal[value!=/^(?:fast|base|slow)$/]",
        "message": "<AnimatedIcon> speed must be one of 'fast' | 'base' | 'slow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|accent|solid)$/]",
        "message": "<Badge> variant must be one of 'outline' | 'accent' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|onClick|href|disabled|icon|type|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, onClick, href, disabled, icon, type, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|address|email|links|social|className|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: logo, address, email, links, social, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|value|onChange|state|helperText|name|className|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, type, placeholder, value, onChange, state, helperText, name, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|textarea)$/]",
        "message": "<FormField> type must be one of 'text' | 'email' | 'tel' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|error|success)$/]",
        "message": "<FormField> state must be one of 'default' | 'focus' | 'error' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|radius|padding|className|style|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: children, radius, padding, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|className|style|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: children, href, variant, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|inverse)$/]",
        "message": "<Link> variant must be one of 'inline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|lang|onToggleLang|className|style|key|ref|className|style|children)$/]",
        "message": "<NavHeader> doesn't accept that prop. Declared props: logo, links, lang, onToggleLang, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavHeader'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:SR|EN)$/]",
        "message": "<NavHeader> lang must be one of 'SR' | 'EN'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|icon|align|className|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, description, icon, align, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:aperture|lens|motion|pulse|light|capture)$/]",
        "message": "<SectionHeader> icon must be one of 'aperture' | 'lens' | 'motion' | 'pulse' | 'light' | 'capture'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|index|className|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: icon, title, description, index, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:aperture|lens|motion|pulse|light|capture)$/]",
        "message": "<ServiceCard> icon must be one of 'aperture' | 'lens' | 'motion' | 'pulse' | 'light' | 'capture'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|client|tags|thumbnail|year|className|style|key|ref|className|style|children)$/]",
        "message": "<WorkCard> doesn't accept that prop. Declared props: title, client, tags, thumbnail, year, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
