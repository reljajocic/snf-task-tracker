{
  "name": "snf-task-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "invite": "node --env-file=.env.local scripts/invite-user.mjs",
    "import:nolimit": "JITI_FS_CACHE=false JITI_ALIAS=\"{\\\"@/\\\":\\\"$PWD/src/\\\"}\" node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/import-nolimit.ts",
    "import:motomilano": "JITI_FS_CACHE=false JITI_ALIAS=\"{\\\"@/\\\":\\\"$PWD/src/\\\"}\" node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/import-motomilano.ts",
    "import:beric": "JITI_FS_CACHE=false JITI_ALIAS=\"{\\\"@/\\\":\\\"$PWD/src/\\\"}\" node --env-file=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/import-beric.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "html2canvas-pro": "2.5.2",
    "jspdf": "4.2.1",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
