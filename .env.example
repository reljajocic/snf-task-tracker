# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://tbjeopsteyqgarjuswzl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses row level security — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Where the app runs (used by scripts; the app itself uses the request's host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend API key for notification emails (Resend → API Keys, "Sending access").
RESEND_API_KEY=re_...
# Shared secret for the daily reminders endpoint (/api/cron/reminders). Any long random string.
CRON_SECRET=
